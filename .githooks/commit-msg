#!/bin/sh
# No song names in commit messages (list: .git/info/song-names, local, never committed).
names="$(git rev-parse --git-dir)/info/song-names"
[ -s "$names" ] || exit 0
hit=$(grep -v '^#' "$1" | grep -i -w -F -f "$names")
[ -z "$hit" ] || { echo "commit-msg: the message names a song: $hit"; exit 1; }
exit 0
